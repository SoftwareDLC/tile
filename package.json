{
  "name": "@software-dlc/tile",
  "version": "0.2.2",
  "description": "Token-efficient tabular encoding for JSON and LLM prompt payloads.",
  "type": "module",
  "license": "MIT",
  "author": "SoftwareDLC",
  "homepage": "https://github.com/SoftwareDLC/tile#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SoftwareDLC/tile.git"
  },
  "bugs": {
    "url": "https://github.com/SoftwareDLC/tile/issues"
  },
  "keywords": [
    "json",
    "llm",
    "prompt-engineering",
    "prompt-optimization",
    "token-reduction",
    "serialization",
    "typescript",
    "tile",
    "tabular",
    "encoding"
  ],
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "tile": "dist/cli.js"
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.4.0",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "benchmark": "pnpm benchmark:fixtures && pnpm benchmark:run",
    "benchmark:fixtures": "tsx scripts/fetch-benchmark-fixtures.ts",
    "benchmark:reasoning": "tsx scripts/run-reasoning-eval.ts",
    "benchmark:run": "tsx scripts/run-benchmarks.ts",
    "build": "pnpm build:esm && pnpm build:cjs",
    "build:cjs": "esbuild src/index.ts --bundle --platform=node --target=node20 --format=cjs --sourcemap --outfile=dist/index.cjs",
    "build:esm": "tsc -p tsconfig.build.json && node -e \"require('node:fs').chmodSync('dist/cli.js', 0o755)\"",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "harness:design": "tsx scripts/design-first-class-tile.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "test:package": "pnpm build && node scripts/smoke-package.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^20.19.25",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.1",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^2.1.9",
    "yaml": "^2.9.0"
  }
}
